# Copy to .env and fill in. .env is git-ignored; this file is the only
# committed one and must only ever hold placeholders.
#
# The server reads the environment only; a .env file is for your shell or your
# MCP host, e.g. `set -a; . ./.env; set +a` before starting it.

# Required. Bring your own key: portal.discover.swiss, product Infocenter Open.
DISCOVER_SWISS_KEY=replace-with-your-subscription-key

# Optional.
DISCOVER_SWISS_PROJECT=dsod-content
DISCOVER_SWISS_MCP_LOG_LEVEL=INFO
# Date of discover.swiss's written search confirmation, or pending.
DISCOVER_SWISS_ENTITLEMENT_CONFIRMED=pending

# HTTP transport (stdio is the default and needs none of this).
# DISCOVER_SWISS_MCP_TRANSPORT=streamable-http
# DISCOVER_SWISS_MCP_HOST=127.0.0.1
# DISCOVER_SWISS_MCP_PORT=8000
# Exact Host values clients send; required for any non-loopback bind.
# DISCOVER_SWISS_MCP_ALLOWED_HOSTS=mcp.example.ch
# DISCOVER_SWISS_MCP_ALLOWED_ORIGINS=

# Inbound OAuth (HTTP transport): all five or none; required for a
# non-loopback bind. See SECURITY.md.
# DISCOVER_SWISS_MCP_AUTH_ISSUER=https://login.example.ch/realms/mcp
# DISCOVER_SWISS_MCP_AUTH_RESOURCE_URL=https://mcp.example.ch/mcp
# DISCOVER_SWISS_MCP_AUTH_INTROSPECTION_URL=https://login.example.ch/realms/mcp/protocol/openid-connect/token/introspect
# DISCOVER_SWISS_MCP_AUTH_CLIENT_ID=discover-swiss-mcp
# DISCOVER_SWISS_MCP_AUTH_CLIENT_SECRET=replace-with-your-client-secret
